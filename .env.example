# New provider configuration. Store real credentials only in the ignored .env
# or the host's environment settings, never in this example or the browser.
THUMBNAIL_IMAGE_PROVIDER=higgsfield
THUMBNAIL_VISION_PROVIDER=gemini
HF_API_KEY_ID=
HF_API_KEY_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_REVIEW_MODEL=gemini-3.8-flash
# Higgsfield uses Marketing Studio Image 2.5 Sunburst, high, 2K, 9:16.
# Higgsfield API billing is separate from subscription/plugin credits.
# Gemini planning and review have separate Google API billing/limits.
# Rollback only: set both provider selectors to openai and configure
# OPENAI_API_KEY with the legacy OPENAI_* options documented in README.md.
THUMBNAIL_AGENT_HOST=127.0.0.1
THUMBNAIL_AGENT_PORT=8787
