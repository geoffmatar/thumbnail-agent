OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-5.5
# Scene generation without person references.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst-2026-09-08
OPENAI_IMAGE_QUALITY=medium
# Person-reference edits have independent defaults and use the same API key.
OPENAI_PERSON_IMAGE_MODEL=gpt-image-2.5-sunburst-2026-09-08
OPENAI_PERSON_IMAGE_QUALITY=high
# Visible-feature appearance review; independent of script/gaze OPENAI_MODEL.
OPENAI_PERSON_REVIEW_MODEL=gpt-6-astra
THUMBNAIL_AGENT_HOST=127.0.0.1
THUMBNAIL_AGENT_PORT=8787
